    "@better-auth/passkey": "^1.7.1",
    "@kingironman2011/next-limitr": "^1.1.5",
    "@tailwindcss/postcss": "^4.3.3",
    "better-auth": "^1.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.4",
    "lucide-react": "^1.34.0",
    "next": "^16.3.3",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "redis": "^6.2.1",
    "shadcn": "^4.19.0",
